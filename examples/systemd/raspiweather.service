[Unit]
Description=raspiweather service
After=network.target

[Service]

# Do not forget to create raspiweather user and add it to i2c group
#
# Example id output:
#  $ id raspiweather
#  uid=1001(raspiweather) gid=1001(raspiweather) groups=1001(raspiweather),988(i2c)

User=raspiweather
Group=raspiweather
Type=simple

ExecStart=/usr/bin/raspiweather -bmeSensors OUT:/dev/i2c-1:0x76,IN:/dev/i2c-1:0x77 -lcd -lcdBacklight
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target